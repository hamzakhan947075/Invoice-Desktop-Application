{
  "name": "invoiceflow-desktop",
  "version": "0.1.0",
  "description": "Self-contained desktop invoicing app — invoices, quotes, credit notes, expenses, inventory, and recurring billing, backed by a local SQLite file.",
  "author": {
    "name": "Muhammad Hamza",
    "email": "muhammad.hamza@secureism.com"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "electron:dev:next": "next dev -p 5175",
    "electron:dev:main": "tsup electron/main.ts electron/preload.ts --outDir dist-electron --format cjs --external electron --watch --onSuccess \"electron .\"",
    "electron:dev": "concurrently -k \"npm:electron:dev:next\" \"wait-on http://127.0.0.1:5175 && npm:electron:dev:main\"",
    "electron:build:next": "next build && node scripts/copy-standalone-assets.mjs",
    "electron:build:main": "tsup electron/main.ts electron/preload.ts --outDir dist-electron --format cjs --external electron",
    "electron:pack": "npm run electron:build:next && npm run electron:build:main && electron-builder",
    "electron:pack:win": "npm run electron:build:next && npm run electron:build:main && electron-builder --win",
    "electron:pack:mac": "npm run electron:build:next && npm run electron:build:main && electron-builder --mac",
    "electron:pack:linux": "npm run electron:build:next && npm run electron:build:main && electron-builder --linux"
  },
  "build": {
    "appId": "com.invoiceflow.desktop",
    "productName": "InvoiceFlow",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "hamzakhan947075",
      "repo": "Invoice-Desktop-Application"
    },
    "files": [
      "dist-electron/**"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      },
      {
        "from": "build-resources",
        "to": "build-resources"
      }
    ],
    "asarUnpack": [
      "**/node_modules/@libsql/**",
      "**/node_modules/libsql/**",
      "**/node_modules/prisma/**",
      "**/node_modules/@prisma/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "icon": "build-resources/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build-resources/icon.png"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "png2icons": "^2.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
