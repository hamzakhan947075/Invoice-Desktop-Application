# SQLite database file path used by Prisma. A relative path is resolved
# against the working directory the app is started from; the desktop
# (Electron) launcher points this at a writable per-user data directory.
DATABASE_URL="file:./dev.db"

# Shared secret that authorizes calls to /api/cron/recurring-invoices.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
